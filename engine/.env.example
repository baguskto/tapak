HOST=127.0.0.1
PORT=8790
# Shared secret between the Worker and the engine (x-tapak-secret header)
TAPAK_SECRET=
WORKER_BASE=https://tapak.bagusin.site
PUBLIC_BASE=https://tapak.bagusin.site
TELEGRAM_TOKEN=
# MiniMax directly, or Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/custom-minimax
AI_BASE=https://api.minimax.io
AI_KEY=
AI_MODEL=MiniMax-M3
# Optional: token for an authenticated AI Gateway (cf-aig-authorization)
CF_AIG_TOKEN=
RPC_URL=https://bsc-testnet-rpc.publicnode.com
RELAYER_PRIVATE_KEY=
REGISTRY_ADDRESS=
USDT_ADDRESS=
EXPLORER=https://testnet.bscscan.com
USDT_IDR=16400
